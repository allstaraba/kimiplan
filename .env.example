# REQUIRED — no hardcoded fallbacks. The server will refuse to start without these.
ANTHROPIC_API_KEY=your-api-key-here
JWT_SECRET=generate-a-long-random-string-here-min-32-chars

# OPTIONAL
PORT=3000
DATA_DIR=./data
AI_PROVIDER=anthropic
CLAUDE_MODEL=claude-opus-4-5
OPENAI_MODEL=gpt-4o

# Set to 1 in production to enforce clinical review gates
REQUIRE_CLINICAL_REVIEW=0
