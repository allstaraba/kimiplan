# Anthropic API — used by the chatbot server
ANTHROPIC_API_KEY=

# CentralReach Institute credentials — used only by ingest.js
# Put real values in .env (which is gitignored). NEVER commit real credentials.
CR_USERNAME=
CR_PASSWORD=

# Optional URL overrides — defaults point at https://community.centralreach.com/
CR_LOGIN_URL=
CR_LIBRARY_URL=

# Server port
PORT=3100

# Set HEADLESS=false on the first ingest run so you can watch the browser
# and adjust selectors in ingest.js if login or article discovery fails.
HEADLESS=true
